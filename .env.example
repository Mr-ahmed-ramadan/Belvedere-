# Copy this file to `.env` and fill in the values.
# For local development the defaults below work with zero external services.

# --- Database (SQLite) ---
# A single file database. Back it up by copying the file.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth) ---
# Generate a secret with:  openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# The public base URL of the app (used in invite emails).
# Local dev:
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Email (Resend) ---
# Leave EMAIL_PROVIDER=console in development: emails are printed to the
# server console instead of being sent, so no account is needed.
# In production set EMAIL_PROVIDER=resend and provide the keys below.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Belvedere <noreply@example.com>"

# --- Money / currency ---
# ISO currency code used for all financial figures. Default GBP.
# NEXT_PUBLIC_CURRENCY makes it available to the browser too.
CURRENCY="GBP"
NEXT_PUBLIC_CURRENCY="GBP"
MONEY_LOCALE="en-GB"

# --- File uploads ---
# Directory where document files are stored (relative to project root).
# In production point this at a persistent volume.
UPLOAD_DIR="./uploads"
